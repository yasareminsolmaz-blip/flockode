{
  "expo": {
    "name": "Flockode",
    "slug": "flockode",
    "scheme": "flockode",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#12213A",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": false,
      "bundleIdentifier": "com.yasarss.flockode",
      "infoPlist": {
        "CFBundleLocalizations": [
          "en",
          "tr",
          "de",
          "es",
          "nl",
          "fr",
          "en",
          "tr",
          "de",
          "es",
          "nl",
          "fr"
        ],
        "CFBundleDevelopmentRegion": "en",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.yasarss.flockode"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-iap",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#12213A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "yasarss-team",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cefbce17-3767-49bd-a229-52377f8baf68"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/cefbce17-3767-49bd-a229-52377f8baf68"
    }
  }
}
